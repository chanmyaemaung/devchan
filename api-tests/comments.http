@baseUrl = http://localhost:3000/api/v1
@authToken = your_jwt_token_here

### Create a new comment (Authenticated)
# Requires: Valid JWT token
# Creates a new comment on a blog post
POST {{baseUrl}}/comments
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "content": "This is a test comment. Great article!",
  "blogId": "blog_id_here"
}

### Get all comments for a blog post
# Returns: Array of comments with user information
# Sorted by: Created date (newest first)
GET {{baseUrl}}/comments/blog/blog_id_here

### Get all comments by a user
# Returns: Array of comments with blog information
# Sorted by: Created date (newest first)
GET {{baseUrl}}/comments/user/user_id_here

### Get a specific comment by ID
# Returns: Single comment with user and blog information
GET {{baseUrl}}/comments/comment_id_here

### Update a comment (Authenticated, only owner)
# Requires: Valid JWT token
# Updates: Only if the authenticated user is the comment owner
PATCH {{baseUrl}}/comments/comment_id_here
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "content": "Updated comment content. This article is really helpful!"
}

### Delete a comment (Authenticated, only owner)
# Requires: Valid JWT token
# Deletes: Only if the authenticated user is the comment owner
DELETE {{baseUrl}}/comments/comment_id_here
Authorization: Bearer {{authToken}} 